{
  "name": "snipdock",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "build:app": "bun run tauri build --bundles nsis",
    "build:app:dev": "bun run tauri build --no-bundle",
    "test": "bun test",
    "lint": "bun --bun tsc --noEmit",
    "tauri": "bun node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@happy-dom/global-registrator": "^20.11.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  }
}
